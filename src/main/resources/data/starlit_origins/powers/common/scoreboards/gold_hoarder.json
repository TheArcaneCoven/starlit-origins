{
    "type": "origins:action_on_callback",
    "entity_action_gained": {
        "type": "origins:and",
        "actions": [
            {
                "type": "origins:execute_command",
                "command": "scoreboard objectives add gold_hoarder dummy \"gold hoarder\""
            },
            {
                "type": "origins:execute_command",
                "command": "scoreboard players set @s gold_hoarder 1"
            }
        ]
    },
    "entity_action_lost": {
        "type": "origins:execute_command",
        "command": "scoreboard players reset @s gold_hoarder"
    },
    "execute_chosen_when_orb": true,
    "name": "Gold Hoarder",
    "description": "You are marked as a creature that particularly likes gold."
}